APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=info

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=sns
POSTGRES_PASSWORD=sns
# For docker-compose.prod.yml + APP_ENV=production use a strong password, e.g.:
# POSTGRES_PASSWORD=sns-prod-local-change-me-32chars!!
POSTGRES_DB=sns_x_prod

REDIS_HOST=redis
REDIS_PORT=6379

# Use a long random secret in production (min 32 chars). Weak defaults are rejected when APP_ENV=production.
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=14
# Legacy alias still read by Settings; access tokens use JWT_ACCESS_EXPIRE_MINUTES.
JWT_EXPIRE_HOURS=24

# Vite prod frontend (sns-x-frontend-prod) defaults to http://localhost:5175
CORS_ORIGINS=http://localhost:5175,http://127.0.0.1:5175

# Comma-separated hosts for TrustedHostMiddleware when APP_ENV=production (optional).
# ALLOWED_HOSTS=api.example.com,localhost
